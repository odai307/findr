{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/api/server.js",
    "start:worker": "node dist/worker/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "gen:keys": "tsx scripts/gen-keys.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-pgvector": "0.0.14",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "arctic": "^3.7.0",
    "bullmq": "6.7.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "6.0.0",
    "jose": "^6.2.17",
    "js-tiktoken": "1.0.21",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
