# Copy to backend/.env and fill in. Every variable is validated at startup.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Embedded Postgres stored in backend/.data (no install, no Docker).
# Later, for staging/production: postgres://user:pass@host/db?sslmode=require (Neon)
DATABASE_URL=pglite:./.data/pglite

# In dev both are the Vite server; it proxies /v1 to the API on port 3000.
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:5173

# Generate with: pnpm --filter backend gen:keys
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Optional. From Google Cloud Console > APIs & Services > Credentials (OAuth client, "Web application").
# Authorized redirect URI: http://localhost:5173/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with just an email, for local development. Must be false in production.
DEV_LOGIN_ENABLED=true

# Optional in development. Without it, syncs run inside the API process (no Redis needed).
# Required in production, e.g. an Upstash URL: rediss://default:<password>@<host>:6379
REDIS_URL=

# Optional in development. Without it, a fake local embedder is used (keyword-ish only).
# With it, embeddings use OpenAI's text-embedding-3-small at 512 dimensions.
OPENAI_API_KEY=
